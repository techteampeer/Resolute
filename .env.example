# Supabase — copy this file to .env.local and fill in your project values.
# Only VITE_-prefixed vars are exposed to the browser build (that's intended:
# the anon key is safe for the client WITH Row-Level Security enabled).
# NEVER put the service_role key here — it stays server-side only.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── Server-side only (serverless functions) ────────────────────────────────
# Service-role key bypasses RLS — keep it server-side, never in a VITE_ var.
# Used by api/admin/users.js for user management.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Notifications (services/notify) ───────────────────────────────────────
# Read by the outbox drain only — never by the browser build.
#
# Base for deep links in emails. Without it, messages carry no buttons.
PORTAL_URL=https://portal.resolutetitleservices.com

# preview (default) writes .html/.txt files and mails nobody.
# console logs what it would send. ses actually sends.
# Leaving this unset is deliberate: an unconfigured deploy cannot mail real
# colleagues by accident.
NOTIFY_PROVIDER=preview
NOTIFY_PREVIEW_DIR=preview/notifications

# ── SES (only when NOTIFY_PROVIDER=ses) ───────────────────────────────────
# Must be the region the SES domain identity was verified in — DKIM tokens are
# per region, so a mismatch means re-doing the DNS records.
SES_REGION=us-east-1
NOTIFY_FROM=Resolute Portal <notifications@resolutetitleservices.com>
NOTIFY_REPLY_TO=
# SES_CONFIGURATION_SET=
# On Lambda these come from the execution role and must NOT be set by hand.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The inbound email→order ingest remains removed. No SMTP_*, IMAP_* or MAIL_*
# var is read by the app.
