node_modules/
dist/
.DS_Store
*.local
.vite/
npm-debug.log*

# Environment — never commit real keys (.env.example is the tracked template)
.env
.env.*
!.env.example


# Supabase CLI local runtime state
supabase/.branches/
supabase/.temp/

# Audit harness. The reusable pieces are tracked (see .audit/README.md); the
# hundreds of one-shot probe scripts and the generated pdf bundle are not.
.audit/*
!.audit/README.md
!.audit/harness.mjs
!.audit/e2e.mjs
!.audit/e2e-single.mjs
!.audit/pdf-build.mjs
!.audit/pdf-entry.js
!.audit/pdf-run.mjs
!.audit/verify-*.mjs
.audit/pdf-bundle.*

# Generated notification previews (scripts/preview-notifications.mjs)
preview/
